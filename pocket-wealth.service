[Unit]
Description=Pocket-Wealth - financial analysis specialist service
Documentation=file:///home/sob/pocket-wealth/README.md
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sob/pocket-wealth
# Dedicated venv (added 2026-09-28) for sqlcipher3-binary - the AES-256 encryption-at-rest
# dependency (see wealth/service.py's _connect()). System python3 has no pip on this host, and
# every other Wealth dependency was stdlib-only until this, so there was no venv before.
ExecStart=/home/sob/pocket-wealth/.venv/bin/python3 -m wealth.service
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

EnvironmentFile=/home/sob/pocket-wealth/.env

# ProtectSystem=strict/ProtectHome=true + ReadOnlyPaths/ReadWritePaths were the original,
# stronger intent here (financial records are among the most sensitive data Pocket holds) but
# failed outright on this host's rootless `systemctl --user` instance - every combination
# tried exited 200/CHDIR ("Changing to the requested working directory failed: No such file or
# directory"), even with WorkingDirectory itself listed in ReadOnlyPaths. Confirmed via a direct
# test (2026-09-26): removing just those directives fixed it immediately, so it's a real
# limitation of this host/kernel's unprivileged user-namespace support for user-manager
# services, not a typo in the unit file. NoNewPrivileges/PrivateTmp don't need that namespace
# remapping and work fine alone. Revisit ProtectSystem/ProtectHome if this ever moves to a
# system-level (root-managed) unit instead of a user one.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
