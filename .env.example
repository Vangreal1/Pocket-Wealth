# Copy to .env (gitignored) and fill in real values. Never commit real secrets.
# Generate each with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# All four must be distinct and at least 32 characters (service.py enforces this at startup).

# Required - Foreman/Pocket -> Wealth task calls.
WEALTH_TOKEN=

# Absolute path to the private SQLite database. Not in git; back this up separately
# (see pocket_backup.py in pocket-agent for the existing encrypted-backup pattern).
WEALTH_DB=/home/sob/pocket-wealth/data/wealth.sqlite3

# Optional - each gates one privileged action. Omit a token to disable that action
# entirely rather than leave it reachable with no real gate.
WEALTH_APPROVAL_TOKEN=
WEALTH_DATA_TOKEN=
WEALTH_SOURCE_TOKEN=
